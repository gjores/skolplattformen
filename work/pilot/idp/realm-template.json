{
  "realm": "skolplattform-test",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": true,
  "sslRequired": "none",
  "internationalizationEnabled": true,
  "supportedLocales": ["sv"],
  "defaultLocale": "sv",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyInitialCounter": 0,
  "attributes": {
    "acr.loa.map": "{\"1\":1,\"2\":2}"
  },
  "clients": [
    {
      "clientId": "skolplattform-worker",
      "secret": "__CLIENT_SECRET__",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:3000/api/auth/callback",
        "http://127.0.0.1:3000/api/auth/callback",
        "http://127.0.0.1:5193/api/auth/callback",
        "http://127.0.0.1:3012/api/auth/callback",
        "http://127.0.0.1:3013/api/auth/callback"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3000/*##http://127.0.0.1:3000/*##http://127.0.0.1:5193/*##http://127.0.0.1:3012/*##http://127.0.0.1:3013/*",
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": ["profile", "email", "acr"],
      "protocolMappers": [
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "authenticationFlows": [
    {
      "alias": "browser-loa",
      "description": "Browser flow with explicit password and LoA 2 TOTP references",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "auth-cookie", "requirement": "ALTERNATIVE", "priority": 10, "userSetupAllowed": false },
        { "flowAlias": "auth-flow-loa", "requirement": "ALTERNATIVE", "priority": 20, "userSetupAllowed": false, "authenticatorFlow": true }
      ]
    },
    {
      "alias": "auth-flow-loa",
      "description": "Ordered conditional authentication levels",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "flowAlias": "loa-1-password", "requirement": "CONDITIONAL", "priority": 10, "userSetupAllowed": false, "authenticatorFlow": true },
        { "flowAlias": "loa-2-otp", "requirement": "CONDITIONAL", "priority": 20, "userSetupAllowed": false, "authenticatorFlow": true }
      ]
    },
    {
      "alias": "loa-1-password",
      "description": "First authentication level requires username and password",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorConfig": "loa-1-condition"
        },
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorConfig": "password-reference"
        }
      ]
    },
    {
      "alias": "loa-2-otp",
      "description": "Second authentication level requires a TOTP credential",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorConfig": "loa-2-condition"
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorConfig": "otp-reference"
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "password-reference",
      "config": { "default.reference.value": "pwd", "default.reference.maxAge": "28800" }
    },
    {
      "alias": "loa-1-condition",
      "config": { "loa-condition-level": "1", "loa-max-age": "28800" }
    },
    {
      "alias": "loa-2-condition",
      "config": { "loa-condition-level": "2", "loa-max-age": "28800" }
    },
    {
      "alias": "otp-reference",
      "config": { "default.reference.value": "otp", "default.reference.maxAge": "28800" }
    }
  ],
  "browserFlow": "browser-loa",
  "users": [
