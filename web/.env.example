NEXT_PUBLIC_APP_MODE=example
# Skyddad databasanslutning är stängd i fas 1 och öppnas i fas 2. Lämna tomma.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
