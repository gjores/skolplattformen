{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "phone": "node scripts/phone-preview.mjs",
    "test": "node --test lib/*.test.mjs",
    "dev:example": "node scripts/run-mode.mjs dev --mode example",
    "dev:example:test": "node scripts/run-mode.mjs dev --mode example --port 5191 --hostname 127.0.0.1",
    "dev:blocked:test": "node scripts/run-mode.mjs dev --mode blocked-probe --port 5192 --hostname 127.0.0.1",
    "dev:protected": "node scripts/run-mode.mjs dev --mode protected",
    "dev:protected:test": "node scripts/run-mode.mjs dev --mode protected --port 5193 --hostname 127.0.0.1",
    "build:example": "node scripts/run-mode.mjs build --mode example",
    "build:protected": "node scripts/run-mode.mjs build --mode protected",
    "preview:example": "node scripts/run-mode.mjs preview --port 3011",
    "preview:protected": "node scripts/run-mode.mjs preview --mode protected --port 3012",
    "e2e": "playwright test",
    "e2e:protected": "playwright test -c playwright.protected.config.ts",
    "verify:phase1": "node scripts/verify-phase1.mjs",
    "verify:phase2": "node scripts/verify-phase2.mjs",
    "verify:phase3": "node scripts/verify-phase3.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "@supabase/supabase-js": "^2.115.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "openid-client": "6.8.8",
    "postgres": "3.4.9",
    "react": "^19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "^19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "^1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@cloudflare/workers-types": "^5.20260903.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "otpauth": "9.5.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "wrangler": "^4.129.0"
  },
  "type": "module"
}
